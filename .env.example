# Sentinel Scan — example environment configuration.
#
# Copy to `.env` and edit. Every value here is optional; the defaults in
# src/sentinel/core/config.py are used when a variable is unset.
#
# Precedence (highest wins):
#   1. command-line flags
#   2. environment variables (this file)
#   3. config.toml in the user config directory
#   4. built-in defaults

# ======================================================================
# Client
# ======================================================================

# Directory for the local database, logs and the quarantine vault.
# Defaults to the platform user-data dir, e.g.
#   Windows: %LOCALAPPDATA%\sentinel-scan
#   Linux:   ~/.local/share/sentinel-scan
#   macOS:   ~/Library/Application Support/sentinel-scan
# SENTINEL_DATA_DIR=

# Log verbosity: DEBUG | INFO | WARNING | ERROR
SENTINEL_LOG_LEVEL=INFO

# Worker threads used for file scanning. 0 = auto (CPU count, capped at 16).
SENTINEL_THREADS=0

# Skip content detectors for files larger than this many bytes (256 MiB).
SENTINEL_MAX_FILE_SIZE=268435456

# Recurse into archives up to this depth. 0 disables archive inspection.
SENTINEL_ARCHIVE_DEPTH=2

# Minimum aggregate score (0-100) for a file to be reported as a threat.
SENTINEL_THREAT_THRESHOLD=60

# ======================================================================
# Detection back-ends
# ======================================================================

# ClamAV daemon. Use a unix socket path, or a host/port pair.
# SENTINEL_CLAMD_SOCKET=/var/run/clamav/clamd.ctl
# SENTINEL_CLAMD_HOST=127.0.0.1
# SENTINEL_CLAMD_PORT=3310

# Extra directory of .yar / .yara rules to load on top of the bundled set.
# SENTINEL_YARA_RULES_DIR=

# ======================================================================
# Cloud lookup + feedback (all opt-in)
# ======================================================================

# Base URL of a Sentinel reporting server. Leave empty to stay fully offline.
# SENTINEL_SERVER_URL=https://api.sentinel-scan.example

# API token issued by that server. Never commit a real token.
# SENTINEL_API_TOKEN=

# Send anonymous detection counters. Off unless explicitly set to 1.
SENTINEL_TELEMETRY=0

# Allow uploading suspicious *samples* when a user files a report.
# Off by default — samples can contain personal data.
SENTINEL_ALLOW_SAMPLE_UPLOAD=0

# Repository used for the "file an issue instead" fallback when no server
# is configured.
SENTINEL_GITHUB_REPO=sentinel-scan/sentinel-scan

# ======================================================================
# Server (only read by the code under server/)
# ======================================================================

SENTINEL_SERVER_DB_URL=sqlite:///./data/sentinel-server.db
SENTINEL_SERVER_HOST=0.0.0.0
SENTINEL_SERVER_PORT=8000

# Comma-separated tokens accepted by write endpoints. Generate real ones with
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SENTINEL_SERVER_TOKENS=

# Max accepted sample upload size in bytes (default 32 MiB).
SENTINEL_SERVER_MAX_UPLOAD=33554432

# Directory where uploaded samples are stored.
SENTINEL_SERVER_SAMPLE_DIR=./data/samples
