/*
    Sentinel Scan — Qt stylesheet.

    A dark theme, because this is a tool people run when something is wrong
    and a wall of white is not what you want then.

    The rule the whole sheet follows: a border has to mean something. It
    means "you can type here" (inputs) or "this is data" (tables), and
    nothing else. Grouping is done with space, which does the same job
    without adding a line to look at — see ui/widgets.py.

    One accent colour, #5e9bd6, and it is spent only on the primary action
    and the selected page. If everything is emphasised then nothing is, and
    on a page where one control starts a forty-minute job it needs to be
    obvious which one that is.

    Severity colours match SEVERITY_COLORS in engine/verdict.py so the CLI
    and the GUI agree:
        critical  #ff5555
        high      #ff8844
        medium    #ddbb44
        low       #44aacc
        clean     #66bb66
*/

QWidget {
    background-color: #1e2127;
    color: #d8dee9;
    font-size: 13px;
}

QMainWindow,
QDialog {
    background-color: #1e2127;
}

/* ---------------------------------------------------------------- text */

QLabel#heading {
    font-size: 21px;
    font-weight: 600;
    color: #eceff4;
}

/*
    Section titles. Colour only — the size, the weight, the capitals and the
    tracking are set on the QFont in ui/widgets.py, because Qt's QSS subset
    has neither `text-transform` nor `letter-spacing` and ignores both without
    a word. Setting `font-size` here as well would override the QFont and take
    the tracking with it.
*/
QLabel#sectionTitle {
    color: #7d8797;
}

QLabel#dim {
    color: #8b93a1;
}

QLabel#hint {
    color: #79808d;
    font-size: 12px;
}

QLabel#stats {
    font-family: "Cascadia Mono", "Consolas", "Menlo", monospace;
    color: #a3be8c;
}

QLabel#warning {
    color: #ddbb44;
    font-size: 12px;
}

/* ------------------------------------------------------------- sidebar */

QListWidget#sidebar {
    background-color: #181b20;
    border: none;
    border-right: 1px solid #2b303b;
    outline: none;
    padding-top: 8px;
}

QListWidget#sidebar::item {
    padding: 11px 20px;
    border: none;
    border-left: 3px solid transparent;
    color: #98a0af;
}

/*
    The accent bar is on every item, transparent until selected. Adding the
    border only on :selected would shift the label 3px sideways each time the
    page changes, which reads as the layout twitching.
*/
QListWidget#sidebar::item:selected {
    background-color: #262b34;
    color: #eceff4;
    border-left: 3px solid #5e9bd6;
}

QListWidget#sidebar::item:hover:!selected {
    background-color: #22262e;
    color: #d8dee9;
}

/* ------------------------------------------------------------- buttons */

QPushButton {
    background-color: #2b303b;
    border: none;
    border-radius: 5px;
    padding: 9px 18px;
    color: #d8dee9;
    min-width: 92px;
}

QPushButton:hover {
    background-color: #363d4b;
}

QPushButton:pressed {
    background-color: #232830;
}

QPushButton:disabled {
    background-color: #24282f;
    color: #565d6b;
}

QPushButton#primary {
    background-color: #4c7fb8;
    color: #ffffff;
    font-weight: 600;
}

QPushButton#primary:hover {
    background-color: #5e9bd6;
}

QPushButton#primary:disabled {
    background-color: #33465c;
    color: #7c8899;
}

QPushButton#danger {
    background-color: #2b303b;
    color: #ff8877;
}

QPushButton#danger:hover {
    background-color: #5c2a2a;
    color: #ffffff;
}

/* -------------------------------------------------------------- groups */
/*
    QGroupBox is no longer used by any page — see ui/widgets.py for why —
    but a dialog or a plugin may still create one, and an unstyled group box
    against this background renders as a grey box with black text.
*/
QGroupBox {
    border: none;
    margin-top: 12px;
    padding-top: 12px;
    font-weight: 600;
    color: #7d8797;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0;
}

/* -------------------------------------------------------------- tables */

QTableWidget,
QListWidget,
QTreeWidget {
    background-color: #181b20;
    alternate-background-color: #1c2027;
    border: 1px solid #272c35;
    border-radius: 5px;
    gridline-color: #2b303b;
    selection-background-color: #33465c;
    selection-color: #eceff4;
    outline: none;
}

QTableWidget::item,
QListWidget::item {
    padding: 5px 8px;
}

QHeaderView::section {
    background-color: #232830;
    color: #a9b1c0;
    border: none;
    border-right: 1px solid #2b303b;
    border-bottom: 1px solid #2b303b;
    padding: 7px 8px;
    font-weight: 600;
}

QHeaderView::section:hover {
    background-color: #2b303b;
}

/* --------------------------------------------------------------- input */

QLineEdit,
QPlainTextEdit,
QTextEdit,
QSpinBox,
QComboBox {
    background-color: #14171c;
    border: 1px solid #333a47;
    border-radius: 5px;
    padding: 7px 9px;
    color: #d8dee9;
    selection-background-color: #4c7fb8;
}

QLineEdit:focus,
QPlainTextEdit:focus,
QTextEdit:focus,
QSpinBox:focus,
QComboBox:focus {
    border-color: #5e9bd6;
}

QLineEdit:disabled,
QSpinBox:disabled,
QComboBox:disabled {
    background-color: #1a1d23;
    color: #5b6270;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #181b20;
    border: 1px solid #3b4252;
    selection-background-color: #33465c;
}

QTextEdit#activity,
QTextBrowser#detail {
    background-color: #14171c;
    border: 1px solid #2b303b;
    font-family: "Cascadia Mono", "Consolas", "Menlo", monospace;
    font-size: 12px;
}

/* ---------------------------------------------------------- checkboxes */

QCheckBox,
QRadioButton {
    spacing: 8px;
    padding: 3px 0;
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid #4c566a;
    background-color: #14171c;
}

QCheckBox::indicator {
    border-radius: 3px;
}

QRadioButton::indicator {
    border-radius: 8px;
}

QCheckBox::indicator:checked,
QRadioButton::indicator:checked {
    background-color: #5e9bd6;
    border-color: #5e9bd6;
}

QCheckBox::indicator:disabled,
QRadioButton::indicator:disabled {
    border-color: #333846;
    background-color: #1a1d23;
}

/* ------------------------------------------------------------ progress */

QProgressBar {
    background-color: #22262e;
    border: none;
    border-radius: 4px;
    height: 8px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #5e9bd6;
    border-radius: 4px;
}

/* --------------------------------------------------------------- tabs */

QTabWidget::pane {
    border: 1px solid #2b303b;
    border-radius: 4px;
    top: -1px;
}

QTabBar::tab {
    background-color: #232830;
    color: #98a0af;
    padding: 8px 18px;
    border: 1px solid #2b303b;
    border-bottom: none;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

QTabBar::tab:selected {
    background-color: #2b303b;
    color: #eceff4;
}

/* ------------------------------------------------------- menu / status */

QMenuBar {
    background-color: #181b20;
    border-bottom: 1px solid #2b303b;
}

QMenuBar::item {
    padding: 6px 12px;
    background: transparent;
}

QMenuBar::item:selected {
    background-color: #2b303b;
}

QMenu {
    background-color: #232830;
    border: 1px solid #3b4252;
    padding: 4px;
}

QMenu::item {
    padding: 7px 26px 7px 18px;
    border-radius: 3px;
}

QMenu::item:selected {
    background-color: #33465c;
}

QMenu::separator {
    height: 1px;
    background-color: #3b4252;
    margin: 4px 8px;
}

QStatusBar {
    background-color: #181b20;
    border-top: 1px solid #2b303b;
    color: #8b93a1;
}

/* ----------------------------------------------------------- scrollbar */

QScrollBar:vertical {
    background-color: #181b20;
    width: 11px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #3b4252;
    border-radius: 5px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background-color: #4c566a;
}

QScrollBar:horizontal {
    background-color: #181b20;
    height: 11px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #3b4252;
    border-radius: 5px;
    min-width: 28px;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    height: 0;
    width: 0;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background: none;
}

/* -------------------------------------------------------------- splitter */

QSplitter::handle {
    background-color: #2b303b;
}

QSplitter::handle:vertical {
    height: 3px;
}

QSplitter::handle:horizontal {
    width: 3px;
}

QToolTip {
    background-color: #232830;
    color: #d8dee9;
    border: 1px solid #4c566a;
    padding: 5px 7px;
}

/* --------------------------------------------------------------- flyout */
/*
    The tray panel. Most people will never see anything else, so it gets
    more air than the main window: one answer, one detail, one button.

    The card itself is painted in Flyout.paintEvent rather than styled here,
    because rounded translucent corners do not survive a QSS background on
    every platform.
*/

QFrame#flyoutCard {
    background: transparent;
}

QFrame#flyoutCard QLabel {
    background: transparent;
}

QLabel#flyoutHeadline {
    font-size: 19px;
    font-weight: 600;
    color: #eceff4;
}

QLabel#flyoutDetail {
    font-size: 13px;
    color: #949cab;
}

/*
    The resource line. Deliberately quiet — it is reassurance, not a
    headline — but always present, and monospaced so the digits stop
    jittering as they change.
*/
QLabel#flyoutResources {
    font-family: "Cascadia Mono", "Consolas", "Menlo", monospace;
    font-size: 11px;
    color: #79808d;
}

QPushButton#flyoutPrimary {
    background-color: #3b4252;
    border: none;
    border-radius: 8px;
    color: #eceff4;
    font-size: 14px;
    font-weight: 500;
}

QPushButton#flyoutPrimary:hover {
    background-color: #49546a;
}

QPushButton#flyoutPrimary:pressed {
    background-color: #333c4d;
}

QPushButton#flyoutLink {
    background: transparent;
    border: none;
    color: #79808d;
    font-size: 11px;
    padding: 2px 4px;
}

QPushButton#flyoutLink:hover {
    color: #d8dee9;
}
